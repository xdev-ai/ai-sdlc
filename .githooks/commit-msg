#!/usr/bin/env sh
# Blocks a commit whose message names a customer identifier, before the commit exists.
#
# CI catching this is too late: by then the message is usually already pushed, and a public
# repository does not un-publish. Install with:
#
#     git config core.hooksPath .githooks
#
# Hooks are not shared by clone, so this is opt-in per checkout by design — the CI gate in
# scripts/verify-no-confidential.sh remains the backstop that cannot be skipped.
exec bash "$(dirname "$0")/../scripts/verify-no-confidential.sh" "$1"
