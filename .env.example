POSTGRES_USER=aisdlc
POSTGRES_PASSWORD=replace-with-a-long-local-password
POSTGRES_DB=aisdlc
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-local-password
PORTAL_CLIENT_SECRET=replace-with-portal-client-secret
CLI_CLIENT_SECRET=replace-with-cli-client-secret
AGENT_RUNTIME_CLIENT_SECRET=replace-with-agent-runtime-client-secret
# Development-only portal sign-in for the local topology. Production realms federate real identities.
LOCAL_ADMIN_PASSWORD=replace-with-a-long-local-password
AISDLC_EVIDENCE_S3_ACCESS_KEY=aisdlc-minio
AISDLC_EVIDENCE_S3_SECRET_KEY=replace-with-a-long-object-storage-secret
AISDLC_EVIDENCE_S3_BUCKET=aisdlc-evidence
AISDLC_EVIDENCE_S3_REGION=us-east-1
# HMAC secret for inbound GitHub webhooks. Empty disables the connector rather than trusting unverified input.
AISDLC_GITHUB_WEBHOOK_SECRET=replace-with-a-github-webhook-secret
# AES-256-GCM key for notification destinations and webhook signing secrets. 32 bytes, base64url.
# Without it every notification-channel create fails with HTTP 409. Generate with:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
AISDLC_NOTIFICATION_ENCRYPTION_KEY=replace-with-a-32-byte-base64url-key
